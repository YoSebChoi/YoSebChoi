<!-- //메인 팝업 2개 이상 -->


<script>
$(function () {
	if ($(".popup-swiper").length){
		const popupWrap = document.querySelector(".main-layer .conts-area");
		const popupPlayBtn = document.querySelector(".main-layer .play-btn");
		const popupSwiper = new Swiper(".popup-swiper", {
			observer: true,
			observeParents: true,
			slidesPerView: 1,
			spaceBetween: 16,
			speed: 1000,
			autoplay: {
				delay: 4000,
				disableOnInteraction: false,
			},
			navigation: {
				nextEl: ".popup-control .next-btn",
				prevEl: ".popup-control .prev-btn",
			},
			keyboard: {
				enabled: true,
				onlyInViewport: true,
			},
			a11y: {
				enabled: true,
				prevSlideMessage: "이전 슬라이드",
				nextSlideMessage: "다음 슬라이드",
			},
			pagination: {
				el: ".main-layer .swiper-pagination",
			},
			breakpoints: {
				768: {
					slidesPerView: 2,
					spaceBetween: 20,
				},
			},
			on: {
				afterInit: updateInert,
				slideChangeTransitionEnd: updateInert,
				breakpoint: updateInert
			},
		});

		function updateInert() {
			const allSlides = this.el.querySelectorAll('.swiper-slide');
			allSlides.forEach(slide => {
					slide.inert = true;
					slide.setAttribute('aria-hidden', 'true');
			});

			const activeIdx = this.activeIndex;
			const viewCount = Math.ceil(this.params.slidesPerView) || 1;
			for (let i = 0; i < viewCount; i++) {
				const targetSlide = allSlides[activeIdx + i];
				if (targetSlide) {
					targetSlide.inert = false;
					targetSlide.setAttribute('aria-hidden', 'false');
				}
			}
		}

		popupPlayBtn.addEventListener("click", function() {
			if (this.classList.contains("pause")) {
				popupSwiper.autoplay.stop();
				this.classList.replace("pause", "play");
				this.setAttribute("aria-label", "자동 재생 시작");
			} else {
				popupSwiper.autoplay.start();
				this.classList.replace("play", "pause");
				this.setAttribute("aria-label", "자동 재생 일시정지");
			}
		});

		popupWrap.addEventListener('mouseenter', function(){
			popupSwiper.autoplay.stop();
			popupPlayBtn.classList.replace("pause", "play");
			popupPlayBtn.setAttribute("aria-label", "자동 재생 시작");
		});
		popupWrap.addEventListener('mouseleave', function(){
			if (popupPlayBtn.classList.contains("play")) {
				popupSwiper.autoplay.start();
				popupPlayBtn.classList.replace("play", "pause");
				popupPlayBtn.setAttribute("aria-label", "자동 재생 일시정지");
			}
		});

		popupWrap.addEventListener('focusin', function(){
			popupSwiper.autoplay.stop();
			popupPlayBtn.classList.replace("pause", "play");
			popupPlayBtn.setAttribute("aria-label", "자동 재생 시작");
		});
		popupWrap.addEventListener('focusout', function(e){
			if (!popupWrap.contains(e.relatedTarget)) {
				popupSwiper.autoplay.start();
				popupPlayBtn.classList.replace("play", "pause");
				popupPlayBtn.setAttribute("aria-label", "자동 재생 일시정지");
			}
		});
	}

	if (getCookie("modal_layer01") !== "hide") {
			$("#modal_layer01").addClass("in shown");
			$("#modal_layer01 .modal-back").addClass("in");
	}

	$(".not-view").on('click', function(){
		setCookie("modal_layer01", "hide", 1);
	});

	function getCookie(c_name){
		var i,x,y,ARRcookies=document.cookie.split(";");
		for (i=0;i<ARRcookies.length;i++){
			x=ARRcookies[i].substr(0,ARRcookies[i].indexOf("="));
			y=ARRcookies[i].substr(ARRcookies[i].indexOf("=")+1);
			x=x.replace(/^\s+|\s+$/g,"");
			if (x==c_name){
				return unescape(y);
			}
		}
	}

	function setCookie(c_name,value,exdays){
		var exdate=new Date();
		exdate.setDate(exdate.getDate() + exdays);
		var c_value=escape(value) + ((exdays==null) ? "" : "; expires="+exdate.toUTCString());
		document.cookie=c_name + "=" + c_value;
	}
});

if (!$('#modal_layer01').find('.modal-conts').length) {
	$('#modal_layer01').hide();
}
</script>

