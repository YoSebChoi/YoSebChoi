<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/apt_accent</item>
        <item name="colorPrimaryDark">@color/apt_ground</item>
        <item name="colorAccent">@color/apt_accent</item>
    </style>

    <!-- the app after launch: the page's ground colour behind the web view until it paints -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:windowBackground">@color/apt_ground</item>
        <item name="android:statusBarColor">@color/apt_ground</item>
        <item name="android:navigationBarColor">@color/apt_ground</item>
        <item name="android:windowLightStatusBar">@bool/apt_light_bars</item>
        <item name="android:windowLightNavigationBar">@bool/apt_light_bars</item>
    </style>

    <!-- launch: the building icon on its sky -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/apt_sky</item>
        <item name="windowSplashScreenAnimatedIcon">@mipmap/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/apt_sky</item>
        <item name="android:navigationBarColor">@color/apt_sky</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
